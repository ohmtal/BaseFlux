print "-------- DLS Flux Main --------"
# NOTE this is not what DLS is made for

InitRects = function
    forRange i 100
        Rects[i] = { (math::random 0 500) (math::random 0 500) 30 30 }
        Colors[i] = { (math::random 0 255) (math::random 0 255) (math::random 0 255) 255 }
        Filled[i] = math::random 0 1
    end
end


MoveRects = function
    # copy and copy .. VERY slow and bug in Assign counter  :/
    forRange i 100
        r = Rects[i]
        r[0] = r[0] + 0.1
        r[1] = r[1] + 0.1
        Rects[i] = r
    end
end

InitRects

caption = "DLS Baseflux"
counter = 0
step = 6

OnRender = function
    i = 0;
    forRange i  100
        flux::DrawRect Rects[i] Colors[i] Filled[i]
    end
    flux::DrawFPS 10 30 2
    flux::Text 10 60 caption 4
    flux::Text 150 30 (str::cast (int::cast step - counter)) 2
    if counter > step
        MoveRects
#         InitRects
        counter = 0
    end
    counter = counter + 1
end
