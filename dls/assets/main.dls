print "-------- DLS Flux Main --------"
# NOTE this is not what DLS is made for

caption = "DLS Baseflux"

SDL_EVENT_KEY_DOWN = 0x300
SDL_EVENT_MOUSE_BUTTON_DOWN = 1025
SDLK_ESCAPE     = 0x0000001b
SDLK_PAGEDOWN   = 0x4000004e
SDLK_RIGHT      = 0x4000004f
SDLK_LEFT       = 0x40000050
SDLK_DOWN       = 0x40000051
SDLK_UP         = 0x40000052

WIDTH  = 600.0
HEIGTH = 380.0
COUNT  = 500
flux::size WIDTH HEIGTH WIDTH HEIGTH



InitRects = function
#     a = 255
    forRange i COUNT
#         # 0 1 2 3
#         w = (5 + math::randomf * 30)
#         h = (5 + math::randomf * 20)
#         x = (math::random 0 WIDTH - w)
#         y = (math::random 0 HEIGTH - h )
#         # 4 5 6 7
#         r = (math::random 0 255)
#         g = (math::random 0 255)
#         b = (math::random 0 255)
#         # [a] set before
#         # 8
#         filled =  math::random 0 1
#         # 9 10
#         vx = (math::randomf * 2.0 - 1.0)
#         vy = (math::randomf * 2.0 - 1.0)
#
#         Data[i] = { x y w h r g b a filled vx vy}

        w = (5 + math::randomf * 30)
        h = (5 + math::randomf * 20)
        Rects[i]  = { (math::random 0 WIDTH - w) (math::random 0 HEIGTH - h ) w h }
        Colors[i] = { (math::random 0 255) (math::random 0 255) (math::random 0 255) 255 }
        Vec[i]    = { (math::randomf * 2.0 - 1.0) (math::randomf * 2.0 - 1.0) }
        Filled[i] = math::random 0 1
    end
end

InitRects
# -----------------------------------------------------------------------------

processRects = function
#       !!! VERY SLOW !!!
#     forRange i COUNT
#         d = Data[i]
#         r = { d[0] d[1] d[2] d[3] }
#         c = { d[4] d[5] d[6] d[7] }
#         flux::DrawRect  r c d[8]
#         Data[i][0] = d[0] + d[9]
#         if d[0] + d[2] >= HEIGTH || d[0] <= 0 ;  Data[i][9] =  d[9] * -1.0;;
#
#         Data[i][1] = d[1] + d[10]
#         if d[1] + d[3] >= HEIGTH || d[1] <= 0 ;  Data[i][10] =  d[10] * -1.0;;
#     end
    forRange i COUNT
        flux::DrawRect Rects[i] Colors[i] Filled[i]
        Rects[i][0] = Rects[i][0] + Vec[i][0]
        if Rects[i][0] + Rects[i][2] >= WIDTH || Rects[i][0] <= 0.0;  Vec[i][0] =  Vec[i][0] * -1.0;;

        Rects[i][1] = Rects[i][1] + Vec[i][1]
        if Rects[i][1] + Rects[i][3] >= HEIGTH || Rects[i][1] <= 0;  Vec[i][1] =  Vec[i][1] * -1.0;;
    end
end

OnRender = function
    processRects
    flux::DrawFPS 10 30 2; flux::Text 120 30 (str::format "mouse: %d %d" event::mx event::my) 2
    flux::Text 10 60 caption 4
end

# -----------------------------------------------------------------------------

OnKey = function
    if event::type == SDL_EVENT_KEY_DOWN
       if event::key == SDLK_ESCAPE ; flux::Close;;
    end
end

OnMouse = function
    if event::type == SDL_EVENT_MOUSE_BUTTON_DOWN
        print "button" event::button "down"
    end
end
