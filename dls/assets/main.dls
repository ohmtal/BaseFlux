print "-------- DLS Flux Main --------"

# need curly constructor !!!
color[0] =  50;
color[1] = 150;
color[2] = 150;
color[3] = 255;

rect[0] = 120;
rect[1] = 150;
rect[2] = 30;
rect[3] = 30;

OnRender = function
    i = 0;
    while i < 100
        rect[0] = math::random 0 500
        rect[1] = math::random 0 500
        flux::DrawRect rect color true
        i = i + 1;
    end
    flux::DrawFPS 50 50 5
end
